   ],
   "source": [
    "spm_times  = [results[\"SPM\"][C][\"runtime\"] for C in C_rates]\n",
    "spme_times = [results[\"SPMe\"][C][\"runtime\"] for C in C_rates]\n",
    "\n",
    "plt.figure()\n",
    "plt.plot(C_rates, spm_times, marker=\"o\", label=\"SPM runtime\")\n",
    "plt.plot(C_rates, spme_times, marker=\"o\", label=\"SPMe runtime\")\n",
    "plt.xlabel(\"C-rate\")\n",
    "plt.ylabel(\"Runtime (s)\")\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"../figures/spm_spme_runtime_vs_rate.png\", dpi=300)\n",
    "plt.show()\n"
   ]
