   "source": [
    "import pybamm\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import time"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "5ba62932-d962-4295-820d-3713cee42650",
   "metadata": {},
   "outputs": [],
   "source": [
    "param = pybamm.ParameterValues(\"Chen2020\")\n",
    "C_rates = [0.5, 1, 2, 3]\n",
    "models = {\n",
    "    \"SPM\": pybamm.lithium_ion.SPM(),\n",
    "    \"SPMe\": pybamm.lithium_ion.SPMe()\n",
    "}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "792108c1-e2a3-4d48-8bca-ac5b486ba4ac",
   "metadata": {},
   "outputs": [],
   "source": [
    "results = {}\n",
    "for name, model in models.items():\n",
    "    results[name] = {}\n",
    "    for C in C_rates:\n",
    "        experiment = pybamm.Experiment([\n",
    "            f\"Discharge at {C}C until 2.7 V\"\n",
    "        ])\n",
    "        sim = pybamm.Simulation(\n",
    "            model,\n",
    "            parameter_values=param,\n",
    "            experiment=experiment\n",
    "        )\n",
    "        t0 = time.time()\n",
    "        sol = sim.solve()\n",
    "        runtime = time.time() - t0\n",
    "        results[name][C] = {\n",
    "            \"solution\": sol,\n",
    "            \"runtime\": runtime\n",
    "        }"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "df265840-dd7a-4dba-b661-8437fdea3c53",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 700x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "plt.figure(figsize=(7,5))\n",
    "\n",
    "for C in C_rates:\n",
    "    sol_spm = results[\"SPM\"][C][\"solution\"]\n",
    "    sol_spme = results[\"SPMe\"][C][\"solution\"]\n",
    "    \n",
    "    plt.plot(\n",
    "        sol_spm[\"Time [h]\"].entries,\n",
    "        sol_spm[\"Terminal voltage [V]\"].entries,\n",
    "        \"--\",\n",
    "        label=f\"SPM {C}C\"\n",
    "    )\n",
    "    \n",
    "    plt.plot(\n",
    "        sol_spme[\"Time [h]\"].entries,\n",
    "        sol_spme[\"Terminal voltage [V]\"].entries,\n",
    "        label=f\"SPMe {C}C\"\n",
    "    )\n",
    "\n",
    "plt.xlabel(\"Time [h]\")\n",
    "plt.ylabel(\"Voltage [V]\")\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"../figures/spm_vs_spme_rates.png\", dpi=300)\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "5cc9f9cb-18b4-4fb4-86a8-e54403b0b479",
   "metadata": {},
   "outputs": [
