   "source": [
    "errors = {}\n",
    "\n",
    "from scipy.interpolate import interp1d\n",
    "\n",
    "errors = {}\n",
    "\n",
    "for C in C_rates:\n",
    "    sol_spm  = results[\"SPM\"][C][\"solution\"]\n",
    "    sol_spme = results[\"SPMe\"][C][\"solution\"]\n",
    "\n",
    "    t_spm  = sol_spm[\"Time [s]\"].entries\n",
    "    V_spm  = sol_spm[\"Terminal voltage [V]\"].entries\n",
    "\n",
    "    t_spme = sol_spme[\"Time [s]\"].entries\n",
    "    V_spme = sol_spme[\"Terminal voltage [V]\"].entries\n",
    "\n",
    "    # interpolate SPMe voltage onto SPM time grid (or vice versa)\n",
    "    f = interp1d(t_spme, V_spme, kind=\"linear\", fill_value=\"extrapolate\")\n",
    "    V_spme_on_spm = f(t_spm)\n",
    "\n",
    "    rmse = np.sqrt(np.mean((V_spm - V_spme_on_spm)**2))\n",
    "    errors[C] = rmse\n",
    "\n",
    "errors\n"
   ]
  },
  {
